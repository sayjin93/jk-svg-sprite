{
  "name": "jk-svg-sprite",
  "version": "1.0.0",
  "description": "Takes a bunch of SVG files, optimizes them and bakes them into SVG sprites of several types, along with suitable stylesheet resources (CSS, Sass, LESS, Stylus).",
  "keywords": [
    "icon",
    "icons",
    "svg",
    "png",
    "sprite",
    "spritesheet",
    "stack",
    "generator",
    "css",
    "sass",
    "less",
    "stylus",
    "stylesheet",
    "inline",
    "html",
    "vector",
    "rwd",
    "retina",
    "mustache",
    "esm"
  ],
  "homepage": "https://github.com/sayjin93/jk-svg-sprite",
  "bugs": {
    "url": "https://github.com/sayjin93/jk-svg-sprite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayjin93/jk-svg-sprite.git"
  },
  "license": "MIT",
  "author": "Jurgen Kruja (https://github.com/sayjin93)",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "bin": {
    "jk-svg-sprite": "./bin/jk-svg-sprite.js"
  },
  "files": [
    "bin",
    "lib",
    "tmpl"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "example": "node example.js"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "css-selector-parser": "^3.3.0",
    "csso": "^5.0.5",
    "cssom": "^0.5.0",
    "js-yaml": "^5.4.1",
    "mustache": "^4.2.0",
    "svgo": "^4.1.0",
    "vinyl": "^3.0.1",
    "xpath": "^0.0.34",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "less": "^4.9.1",
    "pixelmatch": "^7.2.0",
    "playwright-chromium": "^1.63.0",
    "pngjs": "^7.0.0",
    "sass": "^1.104.0",
    "stylus": "^0.64.0",
    "vitest": "^5.0.0"
  }
}
